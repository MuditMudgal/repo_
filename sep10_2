//leetcode  ==> majority element(I) 169.

class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int n = nums.size();
        int count = 1;
        int major = nums[0];
        for(int i=1;i<n;i++){
            if(major==nums[i]){
                count++;
            }
            else if(count==0){
                major = nums[i];
                count++;
            }
            else{
                count--;
            }
        }
        return major;
        
    }
};
